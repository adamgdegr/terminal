{
  "name": "adamgdegr-terminal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/version.js && python3 -m http.server ${PORT:-5173} --directory dist",
    "start": "node scripts/version.js && python3 -m http.server ${PORT:-5173} --directory dist",
    "build:version": "node scripts/version.js",
    "check": "node scripts/check.js",
    "test": "node --test --test-timeout=10000 tests/theme.test.cjs",
    "test:e2e": "node --test tests/browser.test.cjs",
    "deploy": "npm run check && npm test && npm run build:version && npx wrangler deploy"
  },
  "engines": {
    "node": ">=22"
  }
}
