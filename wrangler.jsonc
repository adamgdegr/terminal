{
  "name": "terminal",
  "compatibility_date": "2026-11-05",
  "assets": { "directory": "./dist" },
  "workers_dev": true,
  "preview_urls": true,
  // Required by `wrangler preview` (non-production branch builds); settings stay top-level.
  "previews": {},
  "routes": [
    { "pattern": "adamgd.dev", "custom_domain": true }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
